# Client extracts — confidential, and too large to version.
# The pipeline regenerates everything downstream from these.
data/raw/*.csv
!data/raw/.gitkeep

# Large intermediate feature table (7 MB, rebuilt by run_all.py).
# The small serving artefacts ARE committed so the deployed dashboard works.
data/processed/features.csv

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
.pytest_cache/

# OS / editor
.DS_Store
.vscode/
.idea/

# Never commit credentials
.env
*.key
secrets.toml
